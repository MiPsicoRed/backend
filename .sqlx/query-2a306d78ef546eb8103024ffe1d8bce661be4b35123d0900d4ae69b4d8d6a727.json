  "query": "\n                SELECT id, sender_id, receiver_id, content, read_at, created_at\n                FROM messages\n                WHERE (sender_id = $1 AND receiver_id = $2) OR (sender_id = $2 AND receiver_id = $1)\n                ORDER BY created_at ASC\n            ",
